pkgname=python-mock
_pkgname=${pkgname#python-}
pkgver=5.2.0
pkgrel=1
pkgdesc='Mocking and Patching Library for Testing.'
url='https://github.com/testing-cabal/mock/'
arch=('any')
license=('BSD')
depends=('python' 'python-six' 'python-pbr')
makedepends=('python-setuptools')
source=("https://github.com/testing-cabal/mock/archive/$pkgver.tar.gz")
sha512sums=('30b475312ece26b18d848181c6fcd6773d1ff823af29d8e68a235bd8a7c2c6f88a64bf0be82d5cdf7dd03eb79397bf9b485dea96c623a6197247bf9e2b5cc72a')

build() {
  cd "$_pkgname-$pkgver"

  python setup.py build
}

package() {
  cd "$_pkgname-$pkgver"

  python setup.py install --root="$pkgdir" --prefix=/usr -O1 --skip-build

  install -Dm 644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

