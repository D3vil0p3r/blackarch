pkgname=perl-digest-crc
_pkgname=Digest-CRC
pkgver=0.24
pkgrel=1
pkgdesc='Generic interface to CRC algorithms.'
arch=('x86_64' 'aarch64')
license=('PerlArtistic')
url='http://search.cpan.org/dist/Digest-CRC/'
depends=('perl')
makedepends=('perl-module-build' 'perl-module-install')
options=('!emptydirs')
source=("http://search.cpan.org/CPAN/authors/id/O/OL/OLIMAUL/$_pkgname-$pkgver.tar.gz")
sha512sums=('c536cbcc5c4d336b8ec0e9f7737b5d06fbde8cfacd9b0247320b903ce868fefdf583c2bf4cedb306dc5885b7761bbcc58d385e17e939f6300206907d860110dd')

build() {
  cd "$_pkgname-$pkgver"

  perl Makefile.PL INSTALLDIRS=vendor

  make
}

package() {
  cd "$_pkgname-$pkgver"

  make install DESTDIR="$pkgdir"

  find "$pkgdir" -name perllocal.pod -delete
  find "$pkgdir" -name .packlist -delete
}

