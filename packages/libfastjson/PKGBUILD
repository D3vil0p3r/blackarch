pkgname=libfastjson
pkgver=1.2609.0
pkgrel=1
pkgdesc='A performance-focused json library for C.'
arch=('x86_64' 'aarch64')
url='https://github.com/rsyslog/libfastjson'
license=('GPL')
source=("https://github.com/rsyslog/$pkgname/archive/v$pkgver.tar.gz")
sha512sums=('5a2fcf7f83331bda684a4fa1bb9a0b630f7f006846c5a951ec428d9e2ad986b8dfae6c752a7cf0f86dff9aef43232c8ec7ca3a972889a3c70ea9cbebe241cb5c')

build() {
  cd "$pkgname-$pkgver"

  autoreconf -fvi

  ./configure --prefix=/usr

  make
}

package() {
  cd "$pkgname-$pkgver"

  make DESTDIR="$pkgdir" install
}

