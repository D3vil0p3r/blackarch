pkgname=perl-exporter-lite
_pkgname=Exporter-Lite
pkgver=0.09
pkgrel=1
pkgdesc='Lightweight exporting of variables.'
arch=('any')
license=('PerlArtistic')
url='https://metacpan.org/pod/Exporter::Lite'
depends=('perl')
options=(!emptydirs)
source=("http://search.cpan.org/CPAN/authors/id/N/NE/NEILB/$_pkgname-$pkgver.tar.gz")
sha512sums=('fa540b0aba6178031d0448cdd92bdf21226facd0424ca00329eac8b93086f7e53b9f37daf52a53a74b65fa6afe2b2aa236165d4c44e96d63aad19e0764924f92')

build() {
  cd "$_pkgname-$pkgver"

  perl Makefile.PL INSTALLDIRS=vendor

  make
}

package() {
  cd "$_pkgname-$pkgver"

  make install DESTDIR="$pkgdir"

  find $pkgdir -name perllocal.pod -delete
  find $pkgdir -name .packlist -delete
}

