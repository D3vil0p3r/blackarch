# See COPYING for license details.

pkgname=goshs
pkgver=2.1.7
pkgrel=1
pkgdesc='A SimpleHTTPServer written in Go, enhanced with features and with a nice design.'
arch=('x86_64' 'aarch64')
groups=('blackarch' 'blackarch-misc')
url='https://github.com/patrickhener/goshs'
license=('MIT')
depends=()
makedepends=('git' 'go')
source=("$url/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('13798afca3578d2093b00e974c4f8574d5e75fc1c26ed0f9e58513fc7f6a90223d0d19e8763fb81894aa7590f4b69ecc7095d916c7c9eb95740b8b7c1bc19089')

build() {
  cd "$pkgname-$pkgver"

  GOPATH="$srcdir" go mod download
  GOPATH="$srcdir" go build \
    -trimpath \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-s -w" \
    -o $pkgname .
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm 755 $pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md
  install -Dm 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

