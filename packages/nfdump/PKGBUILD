# See COPYING for license details.

pkgname=nfdump
pkgver=1.7.10
pkgrel=1
groups=('blackarch' 'blackarch-networking')
pkgdesc='A set of tools to collect and process netflow data.'
arch=('x86_64' 'aarch64')
url='https://github.com/phaag/nfdump'
license=('BSD')
depends=('libpcap')
makedepends=('flex' 'bison' 'autoconf' 'automake')
source=("https://github.com/phaag/nfdump/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('8a5b597178153462f95198ab1d3c953138fb34ac92196b2cf7ac0717eae716964842bd415b8903e044dba6c6c8862fb6b1f7b11c3a33fec7830965a72e2f0bf7')

prepare() {
  cd "$pkgname-$pkgver"

  ./autogen.sh
}

build() {
  cd "$pkgname-$pkgver"

  ./configure --prefix=/usr --sbindir=/usr/bin

  make
}

package() {
  cd "$pkgname-$pkgver"

  make DESTDIR="$pkgdir" install

  install -Dm 644 -t "$pkgdir/usr/share/doc/$pkgname" README INSTALL NEWS \
    AUTHORS ChangeLog
}

