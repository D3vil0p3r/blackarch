pkgname=asn
pkgver=0.83.0
pkgrel=1
pkgdesc='ASN, RPKI validity, BGP stats, IPv4v6, Prefix, URL, ASPath, Organization, IP reputation, IP geolocation, IP fingerprinting, Network recon, lookup API server, Web traceroute server.'
arch=('any')
groups=('blackarch' 'blackarch-recon')
url='https://github.com/nitefood/asn'
license=('MIT')
depends=('curl' 'whois' 'bind' 'mtr' 'jq' 'ipcalc' 'grepcidr' 'nmap'
         'openbsd-netcat' 'aha')
makedepends=()
source=("https://github.com/nitefood/$pkgname/archive/refs/tags/v$pkgver.zip")
sha512sums=('136051958197c877485bb4bb0a95e9254fde42005d50f7a0b605c791ec06a3bd683b3dab44342b3026da219caeaac1896b0183028ffb99c9de3ca95c06abcd4d')

package() {
  cd "$pkgname-$pkgver"

  install -Dm 755 $pkgname "$pkgdir/usr/bin/$pkgname"

  chmod +x "$pkgdir/usr/bin/$pkgname"
}

