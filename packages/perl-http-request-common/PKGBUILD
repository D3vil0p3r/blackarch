pkgname=perl-http-request-common
_pkgname=HTTP-Message
pkgver=7.04
pkgrel=1
pkgdesc='Construct common HTTP::Request objects'
arch=('any')
license=('PerlArtistic' 'GPL')
options=('!emptydirs')
url='http://search.cpan.org/~gaas/HTTP-Message-6.06/lib/HTTP/Request/Common.pm'
source=("http://search.cpan.org/CPAN/authors/id/O/OA/OALDERS/$_pkgname-$pkgver.tar.gz")
sha512sums=('36e0f2a3819bcba799fa3cd424266c5667af943adf6e3dae2bff0f6cdb3b63a9bda47ac627e1fe3f4da2adb8f9f090dd0a1c810ceb340e842221a07d18159f14')

prepare() {
  cd "$_pkgname-$pkgver"

  export PERL_MM_USE_DEFAULT=1 PERL5LIB="" \
    PERL_AUTOINSTALL=--skipdeps \
    PERL_MM_OPT="INSTALLDIRS=vendor DESTDIR='$pkgdir'" \
    PERL_MB_OPT="--installdirs vendor --destdir '$pkgdir'" \
    MODULEBUILDRC=/dev/null

  /usr/bin/perl Makefile.PL
}

build() {
  cd "$_pkgname-$pkgver"

  make
}

package() {
  cd "$_pkgname-$pkgver"

  make install

  find "$pkgdir" -name .packlist -o -name perllocal.pod -delete
}

