pkgname=python-docx2python
_pkgname=${pkgname#python-}
pkgver=3.7.1
pkgrel=1
pkgdesc='Extract docx headers, footers, text, footnotes, endnotes, properties, and images to a Python object.'
arch=('any')
url='https://pypi.org/project/docx2python/'
license=('MIT')
depends=('python' 'python-lxml')
makedepends=('python-build' 'python-pip')
options=(!emptydirs)
source=("https://files.pythonhosted.org/packages/source/${_pkgname::1}/$_pkgname/$_pkgname-$pkgver.tar.gz")
sha512sums=('7a548e290583c91da7c026319b8d52f64fde8cf510790956ebf37dea52f9f2908d8d52fdb8d7eacb0052a9a62eaa70a6add7dd7bfb456780d143ab85cb18c485')

build() {
  cd "$_pkgname-$pkgver"

  python -m build --wheel --outdir="$startdir/dist"
}

package() {
  cd "$_pkgname-$pkgver"

  pip install \
    --verbose \
    --disable-pip-version-check \
    --no-warn-script-location \
    --ignore-installed \
    --no-compile \
    --no-deps \
    --root="$pkgdir" \
    --prefix=/usr \
    --no-index \
    --find-links="file://$startdir/dist" \
    $_pkgname
}

