pkgname=perl-math-bigint-gmp
_pkgname=Math-BigInt-GMP
pkgver=1.7003
pkgrel=1
pkgdesc='Big integer calculations using the GNU Multiple Precision Arithmetic Library.'
arch=('x86_64' 'aarch64')
url='https://metacpan.org/release/Math-BigInt-GMP'
license=('GPL' 'PerlArtistic')
depends=('perl' 'gmp')
options=(!emptydirs)
source=("http://search.cpan.org/CPAN/authors/id/P/PJ/PJACKLAM/$_pkgname-$pkgver.tar.gz")
sha512sums=('ef7b53b68cf66e9eb23a7cabd15b92a0924bba5dfb1a188aed130813b709eb2f15b5ceaa8a3fc84ea2570a11d7d782f3feed0e52271c9ada979bf46be80083d7')

build() {
  cd "$_pkgname-$pkgver"

  PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

  make
}

package() {
  cd "$_pkgname-$pkgver"

  make install DESTDIR="$pkgdir"

  find $pkgdir -name '.packlist' -delete
  find $pkgdir -name '*.pod' -delete
}

