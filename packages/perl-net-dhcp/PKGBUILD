pkgname=perl-net-dhcp
_pkgname=Net-DHCP
pkgver=0.9
pkgrel=1
epoch=1
pkgdesc='Object methods to create a DHCP packet.'
arch=('any')
url='http://search.cpan.org/~djzort/Net-DHCP-0.684/lib/Net/DHCP.pm'
license=('PerlArtistic' 'GPL')
options=('!emptydirs')
depends=('perl-module-build')
source=("http://search.cpan.org/CPAN/authors/id/D/DJ/DJZORT/$_pkgname-$pkgver.tar.gz")
sha512sums=('7986f33b4aeb6199dfa7c72573d9373faaae189718526c3d5b342830e787e00e0fffb05be38176c5c910eda6968ff5c8ad3b40ecb41a3d16795db33dd2a5cbb1')

prepare() {
  cd "$_pkgname-$pkgver"

  export PERL_MM_USE_DEFAULT=1 PERL5LIB="" \
    PERL_AUTOINSTALL=--skipdeps \
    PERL_MM_OPT="INSTALLDIRS=vendor DESTDIR='$pkgdir'" \
    PERL_MB_OPT="--installdirs vendor --destdir '$pkgdir'" \
    MODULEBUILDRC=/dev/null
}

build() {
  cd "$_pkgname-$pkgver"

  /usr/bin/perl Build.PL

  ./Build installdeps
  ./Build
}

package() {
  cd "$_pkgname-$pkgver"

  ./Build install

  find "$pkgdir" -name .packlist -o -name perllocal.pod -delete
}

