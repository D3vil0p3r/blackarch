pkgname=perl-http-dav
_pkgname=HTTP-DAV
pkgver=0.50
pkgrel=1
pkgdesc='A client module for the WebDAV protocol.'
arch=('any')
license=('PerlArtistic' 'GPL')
options=('!emptydirs')
depends=('perl-libwww' 'perl-uri' 'perl-xml-dom')
url='http://search.cpan.org/dist/HTTP-DAV'
source=("http://search.cpan.org/CPAN/authors/id/C/CO/COSIMO/$_pkgname-$pkgver.tar.gz")
sha512sums=('0ce091f5c67499ff35c750d0c51101b639543a9f527a7b6895fcde06d2e4a13ac65e5087d8370f449da341921629d8cdd3fae96b242ad038d5715247a5d0541d')
_distdir="$_pkgname-$pkgver"

build() {
  cd $_distdir

  ( export PERL_MM_USE_DEFAULT=1 PERL5LIB=""                 \
      PERL_AUTOINSTALL=--skipdeps                            \
      PERL_MM_OPT="INSTALLDIRS=vendor DESTDIR='$pkgdir'"     \
      PERL_MB_OPT="--installdirs vendor --destdir '$pkgdir'" \
      MODULEBUILDRC=/dev/null

    /usr/bin/perl Makefile.PL

    make
  )
}

package() {
  cd $_distdir

  make install

  find "$pkgdir" -name .packlist -o -name perllocal.pod -delete
}

