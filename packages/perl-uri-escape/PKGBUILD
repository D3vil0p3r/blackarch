pkgname=perl-uri-escape
_pkgname=URI
pkgver=5.37
pkgrel=1
pkgdesc='Percent-encode and percent-decode unsafe characters.'
arch=('any')
url='https://metacpan.org/pod/URI::Escape'
license=('PerlArtistic' 'GPL')
options=('!emptydirs')
depends=('perl')
source=("https://cpan.metacpan.org/authors/id/O/OA/OALDERS/$_pkgname-$pkgver.tar.gz")
sha512sums=('c720fa5ab8efda9f67040cc9221a75996807e37fdcdadec4f621778f1bda2de1fc544461b816f6aef8560b23361d597d677cd6f9eaea04a1783ccfb83d234ff5')

build() {
  (
    export PERL_MM_USE_DEFAULT=1 PERL5LIB="" PERL_AUTOINSTALL=--skipdeps \
    PERL_MM_OPT="INSTALLDIRS=vendor DESTDIR='$pkgdir'"     \
    PERL_MB_OPT="--installdirs vendor --destdir '$pkgdir'" \
    MODULEBUILDRC=/dev/null

    cd "URI-$pkgver"

    perl Makefile.PL

    make
  )
}

package() {
  cd "URI-$pkgver"

  make install

  find "$pkgdir" -name .packlist -o -name perllocal.pod -delete
}

