pkgname=perl-furl
_pkgname=Furl
pkgver=3.15
pkgrel=1
pkgdesc='Lightning-fast URL fetcher.'
url='https://metacpan.org/pod/Furl'
arch=('any')
depends=('perl')
makedepends=('perl-module-build' 'perl-module-build-tiny')
license=('Perl')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/S/SY/SYOHEX/$_pkgname-$pkgver.tar.gz")
sha512sums=('13ec4a7ad653cedc7e36493208f358c74cc62658857a650c10077d692a627ec5ab94fdf2097dd79f07b0101296160fad90230ebb5db3a952b62b87564ac980fc')

build() {
  cd  "$_pkgname-$pkgver"

  export PERL_MM_USE_DEFAULT=1 PERL_AUTOINSTALL=--skipdeps \
    PERL_MM_OPT="INSTALLDIRS=vendor DESTDIR='$pkgdir'" \
    PERL_MB_OPT="--installdirs vendor --destdir '$pkgdir'" \
    MODULEBUILDRC=/dev/null

  /usr/bin/perl Build.PL INSTALLDIRS=vendor
  ./Build
}

package() {
  cd  "$_pkgname-$pkgver"

  ./Build install

  find "$pkgdir" -type f -name 'perllocal.pod' -delete;
  find "$pkgdir" -type f -name '.packlist' -delete;
}

